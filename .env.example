# SafeYatra settings - ONE file for the backend, the frontend and the data scripts.
# Everything is optional: the app runs without these, sign-in/admin just stay off.
# Copy this file to .env and fill in what you have.

# --- Clerk sign-in ------------------------------------------------------------
# https://dashboard.clerk.com -> create an application -> "API keys" ->
# copy the Publishable key (starts with pk_test_). The backend works out
# Clerk's public keys from it, so no secret key is needed.
VITE_CLERK_PUBLISHABLE_KEY=
# Secret key (sk_test_...): optional, not used by the app yet
CLERK_SECRET_KEY=

# Clerk user ids (user_...) allowed to open the Admin page, comma separated.
# Sign in to the app once; the Admin page shows your user id to paste here.
ADMIN_USER_IDS=

# --- Optional overrides (leave empty for the defaults) -------------------------
# Only needed if Clerk's keys URL cannot be worked out from the publishable key
CLERK_JWKS_URL=
# Frontend addresses allowed to call the API (default: http://localhost:5173)
CORS_ORIGINS=
# How often live weather is refreshed, in minutes (default 60)
WEATHER_REFRESH_MIN=

# --- Data scripts (scripts/fetch_chamoli_data.py) ------------------------------
# Contact shown in the User-Agent header (Nominatim asks for one)
CONTACT_EMAIL=
# Free key from https://portal.opentopography.org (30 m Copernicus DEM)
OPENTOPO_API_KEY=
# Free developer key from https://developer.tomtom.com (live incidents test)
TOMTOM_API_KEY=
